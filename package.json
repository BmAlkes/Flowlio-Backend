    "@types/morgan": "^1.9.5",
    "@types/node": "^24.0.4",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.4",
    "@types/swagger-ui-express": "^4.1.5",
    "drizzle-kit": "^0.31.6",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
