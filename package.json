{
  "name": "flowlio-backend",
  "version": "1.0.0",
  "main": "index.js",
  "author": "flowlio-backend",
  "repository": "",
  "scripts": {
    "build": "tsc && tsc-alias",
    "build:full": "tsc && tsc-alias && npm run dbgenerate",
    "dev": "ts-node-dev -r tsconfig-paths/register src/server.ts",
    "start": "node dist/src/server.js",
    "dbgenerate": "drizzle-kit generate",
    "dbgenerate:safe": "node scripts/dbgenerate-safe.js",
    "dbpush": "drizzle-kit push",
    "dbstudio": "drizzle-kit studio --port 4983",
    "dbdrop": "drizzle-kit drop",
    "dbintrospect": "drizzle-kit introspect",
    "swagger": "ts-node ./src/configs/swagger.config.ts",
    "tailwind": "npx @tailwindcss/cli -i ./public/input.css -o ./public/output.css --watch",
    "better-auth-generate": "npx @better-auth/cli@latest generate"
  },
  "license": "ISC",
  "_moduleAliases": {
    "@": "dist/src"
  },
  "devDependencies": {
